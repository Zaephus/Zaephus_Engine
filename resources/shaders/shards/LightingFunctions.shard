
vec4 calcAmbient(float _ambientStrength, vec4 _lightColor, vec4 _diffuseColor) {
    return _ambientStrength * _lightColor * _diffuseColor;
}

vec4 calcDiffuse(vec3 _normal, vec3 _lightDir, vec4 _lightColor, vec4 _diffuseColor) {
    float diff = max(dot(_normal, _lightDir), 0.0);
    return _lightColor * diff * _diffuseColor;
}

vec4 calcSpecular(vec3 _normal, vec3 _lightDir, vec3 _viewDir, vec4 _lightColor, vec4 _specularColor, float _specularStrength, float _shininess) {
//    vec3 reflectDir = reflect(-_lightDir, _normal);
//    float spec = pow(max(dot(_viewDir, reflectDir), 0.0), _shininess/2);
    vec3 halfwayDir = normalize(_lightDir + _viewDir);
    float spec = pow(max(dot(_normal, halfwayDir), 0.0), _shininess);

    return _lightColor * _specularStrength * spec * _specularColor;
}

vec4 calcDirLight(DirectionalLight _dirLight, vec3 _normal, vec3 _viewDir, vec4 _diffuseColor, vec4 _specularColor, float _shininess) {
    vec4 ambient = calcAmbient(_dirLight.ambientStrength, _dirLight.color, _diffuseColor);

    vec3 lightDir = normalize(_dirLight.direction);
    vec4 diffuse = calcDiffuse(_normal, lightDir, _dirLight.color, _diffuseColor);

    vec4 specular = calcSpecular(_normal, lightDir, _viewDir, _dirLight.color, _specularColor, _dirLight.specularStrength, _shininess);

    return _dirLight.intensity * (ambient + diffuse + specular);
}

vec4 calcPointLight(PointLight _pointLight, vec3 _normal, vec3 _viewDir, vec4 _diffuseColor, vec4 _specularColor, float _shininess) {
    vec4 ambient = calcAmbient(_pointLight.ambientStrength, _pointLight.color, _diffuseColor);

    vec3 lightDir = normalize(_pointLight.position - fragPos);
    vec4 diffuse = calcDiffuse(_normal, lightDir, _pointLight.color, _diffuseColor);

    vec4 specular = calcSpecular(_normal, lightDir, _viewDir, _pointLight.color, _specularColor, _pointLight.specularStrength, _shininess);

    float dist = length(_pointLight.position - fragPos);
    float attenuation = 1.0 / (_pointLight.constant + _pointLight.linear * dist + _pointLight.quadratic * dist * dist);

    if(attenuation < 0.0) { return vec4(1.0, 0.0, 0.0, 1.0); }

    ambient *= attenuation;
    diffuse *= attenuation;
    specular *= attenuation;

    return _pointLight.intensity * (ambient + diffuse + specular);
}

vec4 calcLighting(vec4 _diffuse, vec4 _specular, float _shininess) {
    vec3 norm = normalize(normal);
    vec3 viewDir = normalize(viewPos - fragPos);
    vec4 result;

    for(int i = 0; i < MAX_DIR_LIGHTS; i++) {
        if(i >= dirLightAmount) { break; }
        vec4 lightResult = calcDirLight(
            dirLights[i],
            norm,
            viewDir,
            _diffuse,
            _specular,
            _shininess
        );
        result += lightResult;
    }
    for(int i = 0; i < MAX_POINT_LIGHTS; i++) {
        if(i >= pointLightAmount) { break; }
        vec4 lightResult = calcPointLight(
            pointLights[i],
            norm,
            viewDir,
            _diffuse,
            _specular,
            _shininess
        );
        result += lightResult;
    }

    return result;
}