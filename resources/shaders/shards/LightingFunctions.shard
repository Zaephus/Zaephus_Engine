
vec4 calcDirLight(DirectionalLight _dirLight, vec3 _normal, vec3 _viewDir, vec4 _diffuse, vec4 _specular, float _shininess) {
    vec4 ambient = _dirLight.ambientStrength * _dirLight.color * _diffuse;

    vec3 lightDir = normalize(_dirLight.direction);
    float diff = max(dot(_normal, lightDir), 0.0);
    vec4 diffuse = _dirLight.color * diff * _diffuse;

    vec3 reflectDir = reflect(-lightDir, _normal);
    float spec = pow(max(dot(_viewDir, reflectDir), 0.0), _shininess);
    vec4 specular = _dirLight.color * _dirLight.specularStrength * spec * _specular;

    return _dirLight.intensity * (ambient + diffuse + specular);
}

vec4 calcPointLight(PointLight _pointLight, vec3 _normal, vec3 _viewDir, vec4 _diffuse, vec4 _specular, float _shininess) {
    vec4 ambient = _pointLight.ambientStrength * _pointLight.color * _diffuse;

    vec3 lightDir = normalize(_pointLight.position - fragPos);
    float diff = max(dot(_normal, lightDir), 0.0);
    vec4 diffuse = _pointLight.color * diff * _diffuse;

    vec3 reflectDir = reflect(-lightDir, _normal);
    float spec = pow(max(dot(_viewDir, reflectDir), 0.0), _shininess);
    vec4 specular = _pointLight.color * _pointLight.specularStrength * spec * _specular;

    float dist = length(_pointLight.position - fragPos);
    float attenuation = 1.0 / (_pointLight.constant + _pointLight.linear * dist + _pointLight.quadratic * dist * dist);

    if(attenuation < 0.0) { return vec4(1.0, 0.0, 0.0, 1.0); }

    ambient *= attenuation;
    diffuse *= attenuation;
    specular *= attenuation;

    return _pointLight.intensity * (ambient + diffuse + specular);
}

vec4 calcLighting(vec4 _diffuse, vec4 _specular, float _shininess) {
    vec3 norm = normalize(normal);
    vec3 viewDir = normalize(viewPos - fragPos);
    vec4 result;

    for(int i = 0; i < MAX_DIR_LIGHTS; i++) {
        if(i >= dirLightAmount) { break; }
        vec4 lightResult = calcDirLight(
            dirLights[i],
            norm,
            viewDir,
            _diffuse,
            _specular,
            _shininess
        );
        result += lightResult;
    }
    for(int i = 0; i < MAX_POINT_LIGHTS; i++) {
        if(i >= pointLightAmount) { break; }
        vec4 lightResult = calcPointLight(
            pointLights[i],
            norm,
            viewDir,
            _diffuse,
            _specular,
            _shininess
        );
        result += lightResult;
    }

    return result;
}